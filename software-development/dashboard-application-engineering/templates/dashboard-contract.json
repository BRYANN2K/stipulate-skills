{
  "schema_version": "1.0",
  "kind": "dashboard",
  "dashboard": {
    "name": "example-operations",
    "mode": "hybrid",
    "primary_users": [
      "operator"
    ],
    "decisions": [
      "Which resource needs intervention?"
    ]
  },
  "data_sources": [
    {
      "id": "resource-api",
      "owner": "platform",
      "grain": "one record per resource",
      "freshness": "within one minute",
      "reconciliation": "compare aggregate and list counts with the source service"
    }
  ],
  "metrics": [
    {
      "id": "unhealthy-resources",
      "label": "Unhealthy resources",
      "source": "resource-api",
      "formula": "count(status = unhealthy)",
      "grain": "resource",
      "freshness": "within one minute"
    }
  ],
  "resources": [
    {
      "id": "resource",
      "label": "Resource",
      "source": "resource-api",
      "identity": "stable resource id",
      "statuses": [
        "healthy",
        "unhealthy",
        "unknown"
      ]
    }
  ],
  "filters": [
    {
      "id": "status",
      "type": "multi-select",
      "scope": "dashboard",
      "default": "all",
      "shareable": true
    }
  ],
  "views": [
    {
      "id": "overview",
      "path": "/resources",
      "purpose": "Prioritize interventions",
      "widgets": [
        {
          "id": "unhealthy-count",
          "type": "metric",
          "subject": "unhealthy-resources"
        },
        {
          "id": "resource-table",
          "type": "resource-table",
          "subject": "resource"
        }
      ],
      "filters": [
        "status"
      ],
      "roles": [
        "operator"
      ],
      "states": [
        "loading",
        "empty",
        "partial",
        "error",
        "ready"
      ]
    }
  ],
  "actions": [
    {
      "id": "retry",
      "resource": "resource",
      "roles": [
        "operator"
      ],
      "destructive": true,
      "confirmation": "Confirm the exact resource and effect",
      "audit_event": "resource.retry.requested",
      "success_state": "Show acceptance then reconcile",
      "failure_state": "Keep row context and offer retry",
      "reconciliation": "Refetch resource and affected aggregate"
    }
  ],
  "permissions": [
    {
      "role": "operator",
      "resources": [
        "resource"
      ],
      "actions": [
        "retry"
      ]
    }
  ],
  "verification": [
    {
      "id": "source-reconciliation",
      "claim": "Metric, table, detail, and action result agree",
      "evidence": "Seeded integration check plus real-browser journey"
    }
  ]
}
